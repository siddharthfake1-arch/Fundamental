{
	"appId": "co.fundamental.app",
	"appName": "Fundamental",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": false,
			"backgroundColor": "#000000",
			"showSpinner": false
		},
		"Keyboard": {
			"resize": "body"
		},
		"StatusBar": {
			"overlaysWebView": true,
			"style": "DARK",
			"backgroundColor": "#04091a"
		}
	}
}
