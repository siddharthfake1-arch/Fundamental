# Fundamental — environment configuration (copy to .env; never commit real secrets)

# Core (required in production — the server refuses to boot without these)
NODE_ENV=production
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
APP_URL=https://your-domain.com
TRUST_PROXY_HOPS=1            # trusted proxy hop count (1 behind Render/nginx; 0 if no proxy)

# OTP delivery (at least one provider required in production)
RESEND_API_KEY=
OTP_FROM=Fundamental <onboarding@your-domain.com>
# or Twilio SMS:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional
OTP_PEPPER=                  # extra secret for OTP HMAC (defaults to JWT_SECRET)
ADMIN_EMAIL=                 # one-time admin bootstrap (no public admin signup)
ADMIN_PASSWORD=              # min 12 chars; rotate after first sign-in
ADMIN_NAME=Administrator
AUTO_SEED=false              # demo data is never seeded in production regardless
DB_PATH=                     # override SQLite path (defaults to server/fundamental.db)
PORT=3000
