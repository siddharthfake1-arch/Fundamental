{
  "name": "fundamental",
  "version": "1.0.0",
  "private": true,
  "description": "Fundamental — Fundraising? Fundamental. A serious fundraising marketplace and professional network for founders and investors.",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "setup": "npm install",
    "postinstall": "cd client && npm install",
    "build": "cd client && npm run build",
    "dev:server": "node server/index.js",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "seed": "node server/seed.js",
    "start": "node server/index.js",
    "test": "npm run test:unit && npm run test:routes",
    "test:unit": "node server/selftest.js",
    "test:routes": "node server/test/routes.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
