{
  "name": "fundamental",
  "version": "1.0.0",
  "private": true,
  "description": "Fundamental — Fundraising? Fundamental. A serious fundraising marketplace and professional network for founders and investors.",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "setup": "npm install",
    "postinstall": "cd client && npm install && npm run build",
    "build": "cd client && npm run build",
    "dev:server": "node server/index.js",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "seed": "node server/seed.js",
    "start": "node server/index.js",
    "test": "npm run test:unit && npm run test:encoding && npm run test:routes",
    "test:unit": "node server/selftest.js",
    "test:encoding": "node server/scripts/check-encoding.js",
    "test:routes": "node server/test/routes.test.js",
    "backup": "node server/scripts/backup.js",
    "restore": "node server/scripts/restore.js"
  },
  "dependencies": {
    "@sentry/node": "^10.63.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "all-the-cities": "^3.1.0",
    "concurrently": "^9.1.2",
    "i18n-iso-countries": "^7.14.0"
  },
  "overrides": {
    "shell-quote": "^1.8.4"
  }
}
